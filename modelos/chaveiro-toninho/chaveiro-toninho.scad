// Toninho keychain - silhouette cut from toninho.png
// Outline data comes from toninho-outline.scad (generated by extract_outline.py).
// Multicolor (AMS lite): export part = "body", "ball" and "details" as separate STLs.

include <toninho-outline.scad>

/* [Part to render] */
part = "all"; // [all, body, ball, details]

/* [Size] */
keychain_height = 50;     // silhouette height, ring not included (mm)
thickness = 3;            // total thickness (mm)
smooth_radius = 0.6;      // removes spikes/gaps thinner than ~2x this (mm)

/* [Key ring] */
ring_outer_diameter = 9;  // ring tab outer diameter (mm)
ring_hole_diameter = 4.5; // hole for the split ring / chain (mm)
ring_overlap = 2.5;       // how far the ring tab sinks into the silhouette (mm)
ring_offset_x = 0;        // horizontal shift from the outline's highest point (mm)

/* [Color inlays (top face)] */
inlay_depth = 0.6;        // depth of ball/eyes/nose inlays = 3 layers of 0.2 (mm)
min_feature_diameter = 1.6; // eyes/nose never smaller than this (mm)

/* [Back text (debossed on the bed side)] */
back_text = "TONINHO";    // empty string disables the text
text_size = 4.4;          // OpenSCAD text size (mm); capitals come out ~4.2 mm tall
text_depth = 0.6;         // deboss depth (mm)
text_position = [0.323, 0.22]; // center, as a fraction of keychain_height
text_font = "Liberation Sans:style=Bold";

/* [Print] */
first_layer_chamfer = 0.4; // elephant-foot chamfer on the bottom edge (mm)
chamfer_steps = 2;         // chamfer built from this many slabs
$fn = 64;

/* [Hidden] */
eps = 0.01;
s = keychain_height;
ring_center = [outline_top[0] * s + ring_offset_x, s + ring_outer_diameter / 2 - ring_overlap];

module silhouette_2d() {
    // opening (removes thin whiskers) then closing (fills narrow notches)
    offset(r = -smooth_radius) offset(r = smooth_radius)
        offset(r = smooth_radius) offset(r = -smooth_radius)
            scale([s, s]) polygon(outline_points);
}

module body_2d() {
    difference() {
        union() {
            silhouette_2d();
            translate(ring_center) circle(d = ring_outer_diameter);
        }
        translate(ring_center) circle(d = ring_hole_diameter);
    }
}

module ellipse(center, radii) {
    translate(center * s)
        scale([max(radii[0] * s, min_feature_diameter / 2), max(radii[1] * s, min_feature_diameter / 2)])
            circle(r = 1);
}

module details_2d() {
    ellipse(left_eye_center, left_eye_radii);
    ellipse(right_eye_center, right_eye_radii);
    ellipse(nose_center, nose_radii);
}

module ball_2d() {
    intersection() {
        difference() {
            translate(ball_center * s) circle(r = ball_radius * s);
            details_2d();
        }
        silhouette_2d();
    }
}

module chamfered_extrude(height, chamfer, steps) {
    step = chamfer / steps;
    for (i = [0 : steps - 1])
        translate([0, 0, i * step])
            linear_extrude(step + eps) offset(delta = -(chamfer - i * step)) children();
    translate([0, 0, chamfer]) linear_extrude(height - chamfer) children();
}

module top_inlay(depth) {
    translate([0, 0, thickness - depth]) linear_extrude(depth) children();
}

module body() {
    difference() {
        chamfered_extrude(thickness, first_layer_chamfer, chamfer_steps) body_2d();
        top_inlay(inlay_depth + eps) { ball_2d(); details_2d(); }
        if (back_text != "")
            translate([text_position[0] * s, text_position[1] * s, -eps])
                linear_extrude(text_depth + eps)
                    mirror([1, 0]) // reads correctly when the keychain is flipped over
                        text(back_text, size = text_size, font = text_font,
                             halign = "center", valign = "center");
    }
}

module ball() { top_inlay(inlay_depth) ball_2d(); }
module details() { top_inlay(inlay_depth) details_2d(); }

if (part == "all") {
    color("BurlyWood") body();
    color("LimeGreen") ball();
    color("Black") details();
} else if (part == "body") {
    body();
} else if (part == "ball") {
    ball();
} else if (part == "details") {
    details();
}
